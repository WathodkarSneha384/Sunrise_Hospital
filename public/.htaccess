# Hostinger / Apache — canonical domain + Next.js static export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old static site URLs
  RewriteRule ^blog\.html$ /blog/ [R=301,L]

  # Canonical host: sunrisepileshospital.com (adjust if your domain differs)
  RewriteCond %{HTTP_HOST} ^www\.sunrisepileshospital\.com$ [NC]
  RewriteRule ^ https://sunrisepileshospital.com%{REQUEST_URI} [L,R=301]

  # Force HTTPS after SSL is enabled in Hostinger
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://sunrisepileshospital.com%{REQUEST_URI} [L,R=301]

  # If folder exists, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If file exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Fallback to directory index.html (trailingSlash export)
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
